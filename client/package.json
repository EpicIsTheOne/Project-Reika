{
  "name": "reika-desktop-client",
  "private": true,
  "version": "0.1.0",
  "description": "An operating system for AI agents.",
  "author": "Project Reika",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,ui -c cyan,blue \"npm:dev:backend\" \"npm:dev:ui\"",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:backend": "tsx src/backend/server.ts",
    "build": "tsc --noEmit && vite build",
    "assets:webp": "python scripts/build-webp-assets.py",
    "build:desktop:main": "node scripts/build-desktop.mjs",
    "build:desktop": "npm --prefix ../server run build:windows-exe && npm run build && npm run build:desktop:main && electron-builder --win nsis --config electron-builder.json",
    "dist:windows": "npm run build:desktop",
    "desktop:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "test:embedded-commandcenter": "tsx scripts/test-embedded-commandcenter.ts"
  },
  "main": "dist-desktop/main.cjs",
  "build": {
    "extends": "./electron-builder.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fish-audio-tts-toolkit": "github:EpicIsTheOne/fish-audio-tts-toolkit#df7f36c918ab9c9bdeb7efc9f55bb728e93b31af",
    "lucide-react": "^0.468.0",
    "openclaw-command-center": "file:../vendor/openclaw-command-center",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  }
}
