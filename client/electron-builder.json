{
  "appId": "dev.agenthub.reika",
  "productName": "Reika",
  "artifactName": "${productName} Setup ${version}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-desktop/**/*",
    "!dist-desktop/**/*.map",
    "package.json"
  ],
  "afterPack": "scripts/after-pack-icon.cjs",
  "extraResources": [
    {
      "from": "dist",
      "to": "client-dist"
    },
    {
      "from": "assets/reika_phase1/brand/reika_app_icon.png",
      "to": "assets/brand/reika_app_icon.png"
    },
    {
      "from": "../server/release/reika-node.exe",
      "to": "reika-node/reika-node.exe"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "assets/reika_phase1/brand/reika_app_icon.ico",
    "signAndEditExecutable": false,
    "signDlls": false
  },
  "nsis": {
    "installerIcon": "assets/reika_phase1/brand/reika_app_icon.ico",
    "uninstallerIcon": "assets/reika_phase1/brand/reika_app_icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Reika"
  }
}
