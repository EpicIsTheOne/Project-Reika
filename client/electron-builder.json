{
  "appId": "dev.agenthub.reika",
  "productName": "AgentHub",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-desktop/**/*",
    "package.json"
  ],
  "afterPack": "scripts/after-pack-icon.cjs",
  "extraResources": [
    {
      "from": "dist",
      "to": "client-dist"
    },
    {
      "from": "assets/agenthub_phase1/brand",
      "to": "assets/brand"
    },
    {
      "from": "../server/release/reika-agent-server.exe",
      "to": "agent-server/reika-agent-server.exe"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "assets/agenthub_phase1/brand/agenthub_app_icon.ico",
    "signAndEditExecutable": false,
    "signDlls": false
  },
  "nsis": {
    "installerIcon": "assets/agenthub_phase1/brand/agenthub_app_icon.ico",
    "uninstallerIcon": "assets/agenthub_phase1/brand/agenthub_app_icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AgentHub"
  }
}
