{
  "name": "project-reika-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reika Relay for pairing, presence, and safe backwards-compatible envelope routing.",
  "bin": {
    "reika-relay": "./dist/relay/cli.js"
  },
  "scripts": {
    "relay": "node dist/relay/cli.js",
    "relay:dev": "tsx src/relay/cli.ts",
    "dev": "tsx src/relay/server.ts",
    "start": "node dist/relay/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
